<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shims are renamed copies of wso.exe; the app host keeps loading wso.dll whatever its own name is. -->
    <AssemblyName>wso</AssemblyName>
    <RootNamespace>WorkspaceOrganizer.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkspaceOrganizer.Core\WorkspaceOrganizer.Core.csproj" />
  </ItemGroup>

</Project>
